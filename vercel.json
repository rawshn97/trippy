{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/trippy",
      "destination": "/index.html"
    },
    {
      "source": "/trippy/",
      "destination": "/index.html"
    },
    {
      "source": "/trippy/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
