{
  "manifest_version": 3,
  "name": "Trippy for Google Docs - Gen Z Verbatim Agent",
  "version": "1.2.0",
  "description": "Trippy: The high-all-the-time paperclip mascot with red eyes for teams searching Google Drive without exact verbatims. No cap.",
  "action": {
    "default_title": "Toggle Trippy"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/*",
        "https://drive.google.com/*",
        "https://rawshn.com/*",
        "http://localhost:*/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
